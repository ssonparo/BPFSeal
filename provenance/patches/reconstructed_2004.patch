+/*
+ * BPFSeal Iteration 2A: coherent map-level bookkeeping snapshot.
+ * Caller must hold a live reference to map; no copy_to_user under mutex.
+ */
+int bpfseal_prog_array_snapshot(struct bpf_map *map,
+				struct bpfseal_map_evidence *evidence)
+{
+	struct bpf_array *array;
+
+	if (!map || !evidence)
+		return -EINVAL;
+	if (map->map_type != BPF_MAP_TYPE_PROG_ARRAY)
+		return -EOPNOTSUPP;
+
+	array = container_of(map, struct bpf_array, map);
+	mutex_lock(&array->aux->poke_mutex);
+	memset(evidence, 0, sizeof(*evidence));
+	evidence->map_id = map->id;
+	evidence->max_entries = map->max_entries;
+	evidence->map_cookie = map->cookie;
+	evidence->generation = array->aux->bpfseal_generation;
+	evidence->valid = array->aux->bpfseal_digest_valid;
+	if (evidence->valid)
+		memcpy(evidence->digest, array->aux->bpfseal_digest,
+		       SHA256_DIGEST_SIZE);
+	mutex_unlock(&array->aux->poke_mutex);
+	return 0;
+}
